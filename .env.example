# ============================================
# Sofía Comercial AI — Variables de Entorno
# ============================================
# Copiar este archivo como .env y completar los valores.
# NUNCA commitear el archivo .env al repositorio.
# ============================================

# --- Telegram ---
# Token del bot de Telegram (obtener con @BotFather)
TELEGRAM_BOT_TOKEN=

# --- IA (Groq) ---
# API key de Groq (obtener en https://console.groq.com)
GROQ_API_KEY=
# Modelo a utilizar
AI_MODEL=llama-3.3-70b-versatile

# --- Base de Datos ---
# SQLite (desarrollo por defecto):
DATABASE_URL=sqlite:///./data/health_advisor.db
# PostgreSQL (producción recomendada):
# DATABASE_URL=postgresql://sofia:password@localhost:5432/sofia_comercial

# --- Entorno ---
# development | production
APP_ENV=development
# true = logging detallado + archivos de log
APP_DEBUG=true
# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# --- Panel Web (opcional) ---
# Puerto del panel FastAPI
PANEL_PORT=8000
