# ============================================
# Sofía Comercial AI — Variables de Entorno
# ============================================
# Copiar este archivo como .env y completar los valores.
# En Render: configurar estas variables en el Dashboard.
# ============================================

# --- Telegram (REQUERIDO) ---
# Token del bot de Telegram (obtener con @BotFather)
TELEGRAM_BOT_TOKEN=

# --- IA (Groq) ---
# API key de Groq (obtener en https://console.groq.com)
GROQ_API_KEY=
# Modelo a utilizar
AI_MODEL=llama-3.3-70b-versatile

# --- Base de Datos ---
# Producción (Render PostgreSQL):
DATABASE_URL=postgresql://user:password@localhost:5432/sofia_comercial
# Desarrollo (SQLite local):
# DATABASE_URL=sqlite:///./health_advisor.db

# --- Entorno ---
# development | production
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# --- Panel Web ---
# Puerto (Render asigna automáticamente via PORT)
PORT=8000

# --- Grupos de Telegram ---
# Chat IDs de los grupos donde el bot publica los ganchos y escucha.
# (separados por coma; el chat_id del grupo es un número negativo)
TELEGRAM_GROUP_CHAT_IDS=
# Ganchos automáticos 4 veces al día (08:30, 13:00, 18:30, 21:30 hora de Córdoba)
TELEGRAM_GROUP_HOOKS=true
# Horarios custom (opcional, formato HH:MM separados por coma)
# TELEGRAM_GROUP_HOOK_HORARIOS=08:30,13:00,18:30,21:30
# Mensaje de invitación "Agregame a tu grupo" 2 veces al día (12:00 y 20:00 Córdoba)
TELEGRAM_GROUP_INVITE=true
# Horarios custom del mensaje de invitación (opcional)
# TELEGRAM_GROUP_INVITE_HORARIOS=12:00,20:00
