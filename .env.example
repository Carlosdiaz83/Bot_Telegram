# ============================================
# Sofía Comercial AI — Variables de Entorno
# ============================================
# Copiar este archivo como .env y completar los valores.
# En Render: configurar estas variables en el Dashboard.
# ============================================

# --- Telegram (REQUERIDO) ---
# Token del bot de Telegram (obtener con @BotFather)
TELEGRAM_BOT_TOKEN=

# --- IA (Groq) ---
# API key de Groq (obtener en https://console.groq.com)
GROQ_API_KEY=
# Modelo a utilizar
AI_MODEL=llama-3.3-70b-versatile

# --- Base de Datos ---
# Producción (Render PostgreSQL):
DATABASE_URL=postgresql://user:password@localhost:5432/sofia_comercial
# Desarrollo (SQLite local):
# DATABASE_URL=sqlite:///./health_advisor.db

# --- Entorno ---
# development | production
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO

# --- Panel Web ---
# Puerto (Render asigna automáticamente via PORT)
PORT=8000
