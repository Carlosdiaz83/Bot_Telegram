# ========================
# Health Advisor AI
# ========================
# Copiar este archivo como .env y completar los valores.

# --- Telegram ---
# Token del bot de Telegram. Obtenerlo con @BotFather en Telegram.
# Ejemplo: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_BOT_TOKEN=

# --- IA (Groq) ---
# API key de Groq. Obtenerla en https://console.groq.com
GROQ_API_KEY=
# Modelo a utilizar (por defecto llama-3.3-70b-versatile)
AI_MODEL=llama-3.3-70b-versatile

# --- Database ---
# DATABASE_URL=sqlite:///./health_advisor.db

# --- App ---
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=INFO
